<view class="container">
  <!-- ============ 顶部：MBTI 16 型 swiper ============ -->
  <view class="card mbti-swiper-card">
    <view class="card-header">
      <view class="card-header-title">MBTI-人格图谱</view>
      <view class="card-header-sub">每一个都是独一无二的你</view>
    </view>

    <swiper class="mbti-swiper"
            autoplay circular
            duration="500" interval="3000"
            indicator-dots
            indicator-color="rgba(139,92,246,0.15)"
            indicator-active-color="#6d28d9">
      <swiper-item wx:for="{{mbtiGroups}}" wx:key="label">
        <view class="mbti-group">
          <view class="mbti-group-label" style="color: {{item.color}}">{{item.label}}</view>
          <view class="mbti-figures">
            <view wx:for="{{item.types}}" wx:for-item="t" wx:key="code"
                  class="mbti-figure" style="color: {{t.color}}">
              <view class="figure-avatar">
                <image wx:if="{{!imgErr[t.code]}}"
                       src="{{t.img}}" mode="aspectFit"
                       class="figure-img"
                       binderror="onImgError"
                       data-code="{{t.code}}" />
                <text wx:else class="figure-emoji-fallback">{{t.emoji}}</text>
              </view>
              <view class="figure-code">{{t.code}}</view>
              <view class="figure-name">{{t.name}}</view>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view class="type-legend">
      <view><text style="color:#7c3aed;">●</text> 分析家</view>
      <view><text style="color:#16a34a;">●</text> 提倡者</view>
      <view><text style="color:#2563eb;">●</text> 守护者</view>
      <view><text style="color:#ea580c;">●</text> 探索者</view>
    </view>
  </view>

  <!-- ============ Hero：性格测试 ============ -->
  <view class="card hero-card">
    <view class="title">性格测试</view>
    <view class="subtitle">MBTI + SBTI + NMTI 全面性格分析</view>

    <view class="hero-desc">
      探索你的真实性格类型！<br/>
      MBTI（16型人格）+ SBTI（抽象行为）+ NMTI（职场牛马）
    </view>

    <view class="btn {{lastMode === 'mbti' ? 'primary-btn' : 'sbti-btn'}}" hover-class="{{lastMode === 'mbti' ? 'primary-btn-active' : 'sbti-btn-active'}}" bindtap="startMBTI">开始 MBTI 性格测试</view>
    <view class="btn {{lastMode === 'sbti' ? 'primary-btn' : 'sbti-btn'}}" hover-class="{{lastMode === 'sbti' ? 'primary-btn-active' : 'sbti-btn-active'}}" bindtap="startSBTI">开始 SBTI 社交电池测试</view>
    <view class="btn {{lastMode === 'nmti' ? 'primary-btn' : 'sbti-btn'}}" hover-class="{{lastMode === 'nmti' ? 'primary-btn-active' : 'sbti-btn-active'}}" bindtap="startNMTI">开始 NMTI 职场牛马测试</view>
    <view class="btn {{lastMode === 'about' ? 'primary-btn' : 'secondary-btn'}}" hover-class="{{lastMode === 'about' ? 'primary-btn-active' : 'secondary-btn-active'}}" bindtap="showAbout">了解测试项目</view>
  </view>

  <view class="card">
    <view class="stats-grid">
      <view class="stat-item">
        <view class="stat-circle"><text class="stat-number">28</text></view>
        <text class="stat-label">MBTI 题</text>
      </view>
      <view class="stat-item">
        <view class="stat-circle"><text class="stat-number">31</text></view>
        <text class="stat-label">SBTI 题</text>
      </view>
      <view class="stat-item">
        <view class="stat-circle"><text class="stat-number">28</text></view>
        <text class="stat-label">NMTI 题</text>
      </view>
      <view class="stat-item">
        <view class="stat-circle"><text class="stat-number" style="font-size: 28rpx;">详尽</text></view>
        <text class="stat-label">报告分析</text>
      </view>
    </view>
  </view>

  <!-- ============ 底部：SBTI 抽象人格 swiper ============ -->
  <view class="card sbti-swiper-card">
    <view class="card-header">
      <view class="card-header-title">SBTI 抽象人格谱</view>
      <view class="card-header-sub">32 种原型 · 精选 8 个抢先看</view>
    </view>

    <swiper class="sbti-swiper"
            autoplay circular
            duration="500" interval="2500">
      <swiper-item wx:for="{{sbtiTypes}}" wx:key="code">
        <view class="sbti-slide">
          <image src="{{item.img}}" mode="aspectFill" class="slide-avatar" binderror="" />
          <view class="sbti-slide-info">
            <view class="sbti-slide-code">{{item.code}}</view>
            <view class="sbti-slide-name">{{item.name}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view class="sbti-cta">完整 32 种解锁 · 测一测才知道 ↑</view>
  </view>

  <!-- ============ NMTI 职场牛马 swiper ============ -->
  <view class="card nmti-swiper-card">
    <view class="card-header">
      <view class="card-header-title">NMTI 职场牛马谱</view>
      <view class="card-header-sub">16 种打工人 · 精选 8 个抢先看</view>
    </view>

    <swiper class="nmti-swiper"
            autoplay circular
            duration="500" interval="2000">
      <swiper-item wx:for="{{nmtiTypes}}" wx:key="code">
        <view class="nmti-slide">
          <image src="{{item.img}}" mode="aspectFill" class="slide-avatar" binderror="" />
          <view class="nmti-slide-info">
            <view class="nmti-slide-code">{{item.code}}</view>
            <view class="nmti-slide-name">{{item.name}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view class="nmti-cta">完整 16 种牛马人格 · 测一测才知道 ↑</view>
  </view>

  <!-- ============ 底部版本信息 ============ -->
  <view wx:if="{{version}}"
        class="footer-version"
        hover-class="version-badge-hover"
        bindtap="showVersionLog">
    <text class="version-badge-ver">v{{version}}</text>
    <text class="version-badge-sep">·</text>
    <text>查看更新日志 ›</text>
  </view>

  <!-- 关于弹窗 -->
  <view class="modal" wx:if="{{showModal}}" catchtap="hideModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">关于测试项目</view>
      <view class="modal-body">
        <view class="section-title">MBTI（16型人格）</view>
        <view style="font-size:28rpx; line-height:1.8; color:#475569; margin-bottom:40rpx;">
          基于4个维度（E/I、S/N、T/F、J/P）划分的16种性格类型，帮助你了解自己的认知方式、决策风格和生活方式。
        </view>

        <view class="section-title">SBTI（抽象行为测试）</view>
        <view style="font-size:28rpx; line-height:1.8; color:#475569; margin-bottom:40rpx;">
          15维模型的趣味人格测试，包含自我、情感、态度、行动、社交五大模型，32种抽象人格，更贴近日常行为表达。
        </view>

        <view class="section-title">NMTI（职场牛马测试）</view>
        <view style="font-size:28rpx; line-height:1.8; color:#475569;">
          基于4个维度（摸鱼/内卷、独狼/合群、忍者/刚哥、稳坐/跑路）划分的16种职场人格，用最接地气的方式解读你的打工人本质。
        </view>
      </view>
      <view class="btn primary-btn" hover-class="primary-btn-active" style="margin-top:40rpx;" bindtap="hideModal">我知道了</view>
    </view>
  </view>

  <!-- 更新日志弹窗 -->
  <view class="modal" wx:if="{{showChangelog}}" catchtap="hideVersionLog">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">更新日志</view>
      <view class="modal-body">
        <view wx:for="{{changelog}}" wx:key="version" class="changelog-item">
          <view class="changelog-head">
            <view class="changelog-version">
              v{{item.version}}
              <text wx:if="{{index === 0}}" class="changelog-latest">最新</text>
            </view>
            <view class="changelog-date">{{item.date}}</view>
          </view>
          <view wx:if="{{item.title}}" class="changelog-subtitle">{{item.title}}</view>
          <view wx:for="{{item.changes}}" wx:for-item="line" wx:key="*this" class="changelog-line">
            • {{line}}
          </view>
        </view>
      </view>
      <view class="btn primary-btn" hover-class="primary-btn-active" style="margin-top:30rpx;" bindtap="hideVersionLog">我知道了</view>
    </view>
  </view>
</view>
