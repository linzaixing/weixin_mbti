<view class="container">
  <view class="card">
    <view class="title">性格测试</view>
    <view class="subtitle">MBTI + SBTI 全面性格分析</view>
    
    <view style="text-align: center; margin: 40rpx 0;">
      <image src="/images/test-icon.png" mode="widthFix" style="width: 200rpx; height: 200rpx;" wx:if="{{false}}"></image>
    </view>
    
    <view style="font-size: 32rpx; line-height: 1.8; color: #475569; margin-bottom: 30rpx;">
      探索你的真实性格类型！<br/>
      MBTI（16型人格）+ SBTI（抽象行为测试）
    </view>
    
    <view class="btn primary-btn" bindtap="startMBTI">开始 MBTI 性格测试</view>
    <view class="btn secondary-btn" bindtap="startSBTI" style="margin-top: 16rpx;">开始 SBTI 社交电池测试</view>
    <view class="btn secondary-btn" bindtap="showAbout" style="margin-top: 30rpx; font-size: 30rpx;">了解 MBTI & SBTI</view>
  </view>
  
  <view class="card" style="margin-top: 40rpx;">
    <view style="display: flex; justify-content: space-around; text-align: center; font-size: 28rpx; color: #64748b;">
      <view>
        <text style="font-size: 48rpx; color: #7c3aed;">28</text><br/>MBTI 题
      </view>
      <view>
        <text style="font-size: 48rpx; color: #7c3aed;">31</text><br/>SBTI 题
      </view>
      <view>
        <text style="font-size: 48rpx; color: #7c3aed;">详尽</text><br/>报告分析
      </view>
    </view>
  </view>

  <!-- 16种MBTI性格小人图 -->
  <view class="card" style="margin-top: 20rpx; padding: 30rpx 24rpx;">
    <view style="font-size: 30rpx; color: #64748b; margin-bottom: 20rpx; text-align: center; font-weight: 500;">16 种性格类型</view>
    <image src="/images/mbti-16-types.jpg" mode="widthFix" style="width: 100%; border-radius: 20rpx;"></image>
    <view style="display: flex; justify-content: space-around; margin-top: 20rpx; font-size: 24rpx; color: #94a3b8;">
      <view><text style="color:#7c3aed;">●</text> 分析家</view>
      <view><text style="color:#16a34a;">●</text> 外交家</view>
      <view><text style="color:#2563eb;">●</text> 守护者</view>
      <view><text style="color:#ea580c;">●</text> 探险家</view>
    </view>
  </view>
  
  <!-- 关于弹窗 -->
  <view class="modal" wx:if="{{showModal}}" catchtap="hideModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">关于MBTI & SBTI</view>
      <view class="modal-body">
        <view class="section-title">MBTI（16型人格）</view>
        <view style="font-size:28rpx; line-height:1.8; color:#475569; margin-bottom:40rpx;">
          基于4个维度（E/I、S/N、T/F、J/P）划分的16种性格类型，帮助你了解自己的认知方式、决策风格和生活方式。
        </view>
        
        <view class="section-title">SBTI（抽象行为测试）</view>
        <view style="font-size:28rpx; line-height:1.8; color:#475569;">
          15维模型的趣味人格测试，包含自我、情感、态度、行动、社交五大模型，27种有趣结果，更贴近日常行为表达。
        </view>
      </view>
      <view class="btn primary-btn" style="margin-top:40rpx;" bindtap="hideModal">我知道了</view>
    </view>
  </view>
</view>