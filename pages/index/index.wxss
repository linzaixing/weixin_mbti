/* ============ 弹窗 ============ */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 10, 40, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  width: 92%;
  max-height: 85%;
  border-radius: 36rpx;
  padding: 48rpx 40rpx;
  overflow-y: auto;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 24rpx 80rpx rgba(109, 40, 217, 0.15);
}

.modal-title {
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  color: #1e1b4b;
  margin-bottom: 36rpx;
  letter-spacing: 1rpx;
}

.modal-body {
  font-size: 28rpx;
}

/* ============ Hero 区域 ============ */
.title {
  text-align: center;
}

.subtitle {
  text-align: center;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #94a3b8;
}

.hero-desc {
  font-size: 28rpx;
  line-height: 2;
  color: #64748b;
  text-align: center;
  margin: 28rpx 0 40rpx;
  letter-spacing: 0.5rpx;
}

/* ============ Hero 卡片顶部装饰线 ============ */
.hero-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 60rpx;
  right: 60rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #7c3aed, #a78bfa 40%, #ec4899 70%, #f59e0b);
  border-radius: 0 0 6rpx 6rpx;
}

/* ============ 卡片入场动画 ============ */
@keyframes cardFadeUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.card {
  animation: cardFadeUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
}

.card:nth-child(1) { animation-delay: 0s; }
.card:nth-child(2) { animation-delay: 0.08s; }
.card:nth-child(3) { animation-delay: 0.16s; }
.card:nth-child(4) { animation-delay: 0.24s; }
.card:nth-child(5) { animation-delay: 0.32s; }
.card:nth-child(6) { animation-delay: 0.4s; }

/* ============ 共享卡片头部 ============ */
.card-header {
  text-align: center;
  margin-bottom: 28rpx;
}

.card-header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e1b4b;
  letter-spacing: 1.5rpx;
}

.card-header-sub {
  font-size: 22rpx;
  color: #a1a1aa;
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

/* ============ MBTI Swiper ============ */
.mbti-swiper-card {
  padding: 40rpx 24rpx 24rpx;
}

.mbti-swiper {
  height: 340rpx;
}

.mbti-group {
  text-align: center;
  padding: 8rpx 0;
}

.mbti-group-label {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  margin-bottom: 20rpx;
  text-transform: uppercase;
}

.mbti-figures {
  display: flex;
  justify-content: space-around;
  padding: 0 16rpx;
}

.mbti-figure {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
}

.figure-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(145deg, #f5f3ff, #ede9fe);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.1);
  border: 2rpx solid rgba(124, 58, 237, 0.08);
}

.figure-img {
  width: 100%;
  height: 100%;
}

.figure-emoji-fallback {
  font-size: 52rpx;
  line-height: 1;
}

.figure-code {
  font-size: 22rpx;
  font-weight: 700;
  color: inherit;
  letter-spacing: 1rpx;
  margin-top: 2rpx;
}

.figure-name {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.type-legend {
  display: flex;
  justify-content: space-around;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(124, 58, 237, 0.06);
  font-size: 22rpx;
  color: #94a3b8;
}

/* ============ 统计区 ============ */
.stats-grid {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #f5f3ff, #ede9fe);
  margin-bottom: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(124, 58, 237, 0.08);
}

.stat-number {
  font-size: 36rpx;
  font-weight: 800;
  color: #6d28d9;
}

.stat-label {
  font-size: 22rpx;
  color: #94a3b8;
  letter-spacing: 0.5rpx;
}

/* ============ SBTI Swiper ============ */
.sbti-swiper-card {
  padding: 40rpx 24rpx 24rpx;
  margin-top: 24rpx;
}

.sbti-swiper {
  height: 200rpx;
}

.sbti-slide {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  margin: 0 16rpx;
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.04), rgba(139, 92, 246, 0.08));
  border-radius: 24rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.08);
}

.slide-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.sbti-slide-info {
  display: flex;
  flex-direction: column;
}

.sbti-slide-code {
  font-size: 34rpx;
  font-weight: 700;
  color: #6d28d9;
  letter-spacing: 1rpx;
}

.sbti-slide-name {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.sbti-cta {
  text-align: center;
  font-size: 22rpx;
  color: #a1a1aa;
  margin-top: 20rpx;
  letter-spacing: 1rpx;
}

/* ============ NMTI Swiper ============ */
.nmti-swiper-card {
  padding: 40rpx 24rpx 24rpx;
  margin-top: 24rpx;
}

.nmti-swiper {
  height: 200rpx;
}

.nmti-slide {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  margin: 0 16rpx;
  background: linear-gradient(135deg, rgba(234, 88, 12, 0.04), rgba(245, 158, 11, 0.08));
  border-radius: 24rpx;
  border: 1rpx solid rgba(234, 88, 12, 0.08);
}

.nmti-slide-emoji {
  display: none;
}

.nmti-slide-info {
  display: flex;
  flex-direction: column;
}

.nmti-slide-code {
  font-size: 34rpx;
  font-weight: 700;
  color: #c2410c;
  letter-spacing: 1rpx;
}

.nmti-slide-name {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.nmti-cta {
  text-align: center;
  font-size: 22rpx;
  color: #a1a1aa;
  margin-top: 20rpx;
  letter-spacing: 1rpx;
}

/* ============ 底部版本信息 ============ */
.footer-version {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 48rpx auto 32rpx;
  padding: 16rpx 36rpx;
  background: rgba(124, 58, 237, 0.04);
  color: #a1a1aa;
  font-size: 22rpx;
  border-radius: 9999px;
  letter-spacing: 1rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.08);
}

.footer-version .version-badge-ver {
  color: #7c3aed;
  font-weight: 600;
}

.version-badge-sep {
  margin: 0 14rpx;
  opacity: 0.4;
}

.version-badge-hover {
  background: rgba(124, 58, 237, 0.1);
  transform: scale(0.97);
}

/* ============ 更新日志弹窗条目 ============ */
.changelog-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(124, 58, 237, 0.06);
}

.changelog-item:last-child {
  border-bottom: none;
}

.changelog-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.changelog-version {
  font-size: 30rpx;
  font-weight: 700;
  color: #5b21b6;
}

.changelog-latest {
  display: inline-block;
  margin-left: 12rpx;
  padding: 4rpx 16rpx;
  background: linear-gradient(135deg, #6d28d9, #8b5cf6);
  color: #fff;
  font-size: 18rpx;
  font-weight: 500;
  border-radius: 9999px;
  vertical-align: middle;
}

.changelog-date {
  font-size: 22rpx;
  color: #a1a1aa;
}

.changelog-subtitle {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.changelog-line {
  font-size: 26rpx;
  line-height: 1.8;
  color: #475569;
  padding: 4rpx 0;
}

/* ============ 暗色模式适配 ============ */
@media (prefers-color-scheme: dark) {
  .card-header-title {
    color: #e9e5f5;
  }

  .card-header-sub {
    color: #71717a;
  }

  .hero-desc {
    color: #94a3b8;
  }

  .hero-card::before {
    opacity: 0.7;
  }

  .figure-avatar {
    background: linear-gradient(145deg, rgba(109, 40, 217, 0.15), rgba(139, 92, 246, 0.1));
    border-color: rgba(139, 92, 246, 0.15);
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  }

  .figure-name {
    color: #71717a;
  }

  .type-legend {
    color: #71717a;
    border-top-color: rgba(139, 92, 246, 0.1);
  }

  .stat-circle {
    background: linear-gradient(145deg, rgba(109, 40, 217, 0.15), rgba(139, 92, 246, 0.1));
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  }

  .stat-number {
    color: #a78bfa;
  }

  .stat-label {
    color: #71717a;
  }

  .sbti-slide,
  .nmti-slide {
    background: rgba(109, 40, 217, 0.08);
    border-color: rgba(139, 92, 246, 0.12);
  }

  .sbti-slide-code {
    color: #a78bfa;
  }

  .nmti-slide-code {
    color: #fb923c;
  }

  .sbti-slide-name,
  .nmti-slide-name {
    color: #94a3b8;
  }

  .footer-version {
    background: rgba(139, 92, 246, 0.06);
    border-color: rgba(139, 92, 246, 0.12);
    color: #71717a;
  }

  .modal-content {
    background: rgba(20, 15, 40, 0.95);
    border-color: rgba(139, 92, 246, 0.2);
  }

  .modal-title {
    color: #e9e5f5;
  }

  .changelog-version {
    color: #a78bfa;
  }

  .changelog-line {
    color: #94a3b8;
  }

  .changelog-item {
    border-bottom-color: rgba(139, 92, 246, 0.08);
  }
}

/* MBTI详解弹窗 */
.mbti-detail-modal {
  text-align: center;
  padding: 56rpx 44rpx;
}

.mbti-detail-header {
  margin-bottom: 24rpx;
}

.mbti-detail-code {
  font-size: 80rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.mbti-detail-name {
  font-size: 40rpx;
  font-weight: 600;
  margin-top: 12rpx;
}

.mbti-detail-desc {
  font-size: 32rpx;
  line-height: 2;
  color: #475569;
  text-align: left;
  padding: 24rpx;
  background: rgba(124, 58, 237, 0.04);
  border-radius: 16rpx;
}
