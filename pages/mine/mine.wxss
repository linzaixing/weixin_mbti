.container {
  padding: 28rpx 32rpx;
  padding-bottom: 60rpx;
}

/* 个人信息卡片 */
.profile-card {
  padding: 40rpx;
}

.profile-header {
  display: flex;
  align-items: center;
}

.profile-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 4rpx solid rgba(124, 58, 237, 0.2);
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.12);
}

.profile-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f3e8ff, #ede9fe);
}

.avatar-placeholder {
  font-size: 56rpx;
  color: #a78bfa;
  font-weight: 300;
}

.profile-info {
  margin-left: 28rpx;
  flex: 1;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
}

.profile-name-input {
  font-size: 32rpx;
  color: #64748b;
  padding: 8rpx 0;
  border-bottom: 2rpx solid rgba(124, 58, 237, 0.2);
}

.profile-stats {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

/* 历史记录 */
.history-list {
  margin-top: 16rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.history-item:last-child {
  border-bottom: none;
}

.history-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.history-mode {
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.history-mode.mbti {
  background: rgba(124, 58, 237, 0.1);
  color: #7c3aed;
}

.history-mode.sbti {
  background: rgba(219, 39, 119, 0.1);
  color: #db2777;
}

.history-mode.nmti {
  background: rgba(234, 88, 12, 0.1);
  color: #ea580c;
}

.history-detail {
  margin-left: 20rpx;
}

.history-result {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.history-time {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.history-arrow {
  font-size: 36rpx;
  color: #cbd5e1;
  font-weight: 300;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 暗色模式 */
@media (prefers-color-scheme: dark) {
  .profile-name {
    color: #f1f5f9;
  }

  .profile-name-input {
    color: #94a3b8;
    border-bottom-color: rgba(139, 92, 246, 0.3);
  }

  .profile-avatar-default {
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.15), rgba(139, 92, 246, 0.1));
  }

  .history-result {
    color: #f1f5f9;
  }

  .history-item {
    border-bottom-color: rgba(255, 255, 255, 0.05);
  }
}

/* 版本信息 */
.footer-version {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 48rpx auto 32rpx;
  padding: 16rpx 36rpx;
  background: rgba(124, 58, 237, 0.04);
  color: #a1a1aa;
  font-size: 22rpx;
  border-radius: 9999px;
  letter-spacing: 1rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.08);
}

.footer-version .version-badge-ver {
  color: #7c3aed;
  font-weight: 600;
}

.version-badge-sep {
  margin: 0 14rpx;
  opacity: 0.4;
}

.version-badge-hover {
  background: rgba(124, 58, 237, 0.1);
  transform: scale(0.97);
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(24px);
  width: 92%;
  max-height: 85%;
  border-radius: 36rpx;
  padding: 48rpx 40rpx;
  overflow-y: auto;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 24rpx 80rpx rgba(109, 40, 217, 0.15);
}

.modal-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 28rpx;
  text-align: center;
}

.changelog-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(124, 58, 237, 0.06);
}

.changelog-item:last-child {
  border-bottom: none;
}

.changelog-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.changelog-version {
  font-size: 30rpx;
  font-weight: 700;
  color: #5b21b6;
}

.changelog-latest {
  display: inline-block;
  margin-left: 12rpx;
  padding: 4rpx 16rpx;
  background: linear-gradient(135deg, #6d28d9, #8b5cf6);
  color: #fff;
  font-size: 18rpx;
  font-weight: 500;
  border-radius: 9999px;
  vertical-align: middle;
}

.changelog-date {
  font-size: 22rpx;
  color: #a1a1aa;
}

.changelog-subtitle {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.changelog-line {
  font-size: 26rpx;
  line-height: 1.8;
  color: #475569;
  padding: 4rpx 0;
}
