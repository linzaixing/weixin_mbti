<view class="container">
  <!-- 个人信息卡片 -->
  <view class="card profile-card">
    <view class="profile-header">
      <view class="avatar-ring" bindtap="chooseAvatar">
        <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" class="profile-avatar" />
        <view wx:else class="profile-avatar profile-avatar-default">
          <text class="avatar-placeholder">+</text>
        </view>
      </view>
      <view class="profile-info">
        <view wx:if="{{!editingName}}" class="profile-name" bindtap="startEditName">
          {{nickName || '设置你的昵称'}}
        </view>
        <input wx:else class="profile-name-input" placeholder="输入昵称" focus="{{editingName}}" bindblur="onNickNameDone" bindconfirm="onNickNameDone" value="{{nickName}}" />
        <view class="profile-stats">已完成 <text class="stats-num">{{historyList.length}}</text> 次测试</view>
      </view>
    </view>
  </view>

  <!-- 历史测试报告 -->
  <view class="card">
    <view class="section-title">历史测试报告</view>

    <view wx:if="{{historyList.length === 0}}" class="empty-state">
      <text class="empty-emoji">📋</text>
      <text class="empty-text">暂无测试记录，去首页测一测吧</text>
    </view>

    <view wx:else class="history-list">
      <view wx:for="{{historyList}}" wx:key="id" class="history-item" bindtap="viewReport" data-index="{{index}}">
        <view class="history-left">
          <view class="history-mode {{item.testMode}}">{{item.modeLabel}}</view>
          <view class="history-detail">
            <view class="history-result">{{item.resultCode}} · {{item.resultName}}</view>
            <view class="history-time">{{item.time}}</view>
          </view>
        </view>
        <text class="history-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 清除数据 -->
  <view class="card">
    <view class="btn secondary-btn" hover-class="secondary-btn-active" bindtap="clearHistory">清除历史记录</view>
  </view>

  <!-- 版本信息 -->
  <view wx:if="{{version}}"
        class="footer-version"
        hover-class="version-badge-hover"
        bindtap="showVersionLog">
    <text class="version-badge-ver">v{{version}}</text>
    <text class="version-badge-sep">·</text>
    <text>查看更新日志 ›</text>
  </view>

  <!-- 更新日志弹窗 -->
  <view class="modal" wx:if="{{showChangelog}}" catchtap="hideVersionLog">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">更新日志</view>
      <view class="modal-body">
        <view wx:for="{{changelog}}" wx:key="version" class="changelog-item">
          <view class="changelog-head">
            <view class="changelog-version">
              v{{item.version}}
              <text wx:if="{{index === 0}}" class="changelog-latest">最新</text>
            </view>
            <view class="changelog-date">{{item.date}}</view>
          </view>
          <view wx:if="{{item.title}}" class="changelog-subtitle">{{item.title}}</view>
          <view wx:for="{{item.changes}}" wx:for-item="line" wx:key="*this" class="changelog-line">
            • {{line}}
          </view>
        </view>
      </view>
      <view class="btn primary-btn" hover-class="primary-btn-active" style="margin-top:30rpx;" bindtap="hideVersionLog">我知道了</view>
    </view>
  </view>
</view>
