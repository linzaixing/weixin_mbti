.result-type {
  font-size: 92rpx;
  font-weight: 800;
  line-height: 1;
  margin: 10rpx 0 16rpx;
  letter-spacing: -3rpx;
  font-feature-settings: "palt";
}

.section-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #4f46e5;
  margin: 10rpx 0 30rpx;
  position: relative;
}

.section-title::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 0;
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(to right, #7c3aed, #a855f7);
  border-radius: 3rpx;
}

/* 更优雅的正文排版 */
.card {
  font-size: 30rpx;
  line-height: 1.75;
  color: #334155;
}

.section-title {
  font-size: 36rpx;
  letter-spacing: -0.5rpx;
}