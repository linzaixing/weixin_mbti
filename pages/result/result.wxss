.result-type {
  font-size: 88rpx;
  font-weight: 800;
  line-height: 1;
  margin: 10rpx 0 16rpx;
  letter-spacing: -2rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #6d28d9;
  margin: 10rpx 0 28rpx;
  position: relative;
  padding-left: 24rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 8rpx;
  background: linear-gradient(180deg, #7c3aed, #a78bfa);
  border-radius: 4rpx;
}

.card {
  font-size: 28rpx;
  line-height: 1.8;
  color: #334155;
}

/* 重置 button 默认样式 */
button.btn {
  margin: 0;
  padding: 0;
  border: none;
  line-height: 100rpx;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 50rpx;
  box-sizing: border-box;
  width: 100%;
  background: rgba(124, 58, 237, 0.06);
  color: #6d28d9;
}

button.btn::after {
  border: none;
}

button.secondary-btn {
  border: 2rpx solid rgba(124, 58, 237, 0.2);
}

/* 截图画布（不可见） */
.share-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 750rpx;
  height: 880rpx;
}

/* 结果页容器 */
.container {
  padding: 28rpx 32rpx;
  padding-bottom: 60rpx;
}

/* 头部结果卡片 */
.result-hero {
  text-align: center;
  padding-top: 36rpx;
  padding-bottom: 36rpx;
}

.result-hero-label {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.result-avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  margin: 16rpx auto;
  display: block;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  background: linear-gradient(135deg, #f3e8ff, #fce7f3);
}

.result-avatar-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  background: linear-gradient(135deg, #f3e8ff, #fce7f3);
}

.result-hero-name {
  font-size: 42rpx;
  font-weight: 700;
  margin: 12rpx 0;
  letter-spacing: -1rpx;
}

.result-hero-slogan {
  font-size: 26rpx;
  color: #64748b;
  padding: 16rpx 28rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  margin: 20rpx 16rpx 0;
  line-height: 1.7;
}

/* 优势/盲点条目 */
.trait-item {
  padding: 20rpx 24rpx;
  margin: 12rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.trait-strength {
  background: rgba(74, 222, 128, 0.1);
  border-left: 8rpx solid #4ade80;
  color: #166534;
}

.trait-weakness {
  background: rgba(248, 113, 113, 0.1);
  border-left: 8rpx solid #f87171;
  color: #991b1b;
}

/* 职业标签 */
.career-tag {
  display: inline-block;
  background: rgba(124, 58, 237, 0.08);
  color: #6d28d9;
  padding: 14rpx 28rpx;
  border-radius: 9999px;
  font-size: 24rpx;
  letter-spacing: 0.5rpx;
}

/* 名人标签 */
.famous-tag {
  display: inline-block;
  background: rgba(251, 191, 36, 0.15);
  color: #92400e;
  padding: 12rpx 22rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}

/* 匹配区 */
.match-block {
  padding: 24rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.match-block-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.match-block-text {
  font-size: 28rpx;
  margin-top: 8rpx;
  line-height: 1.7;
}

/* 底部操作区 */
.result-actions {
  margin: 48rpx 0 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-actions .btn {
  width: 80%;
  text-align: center;
}

/* 入场动画 */
@keyframes resultFadeUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.card {
  animation: resultFadeUp 0.45s cubic-bezier(0.4, 0, 0.2, 1) both;
}

.card:nth-child(1) { animation-delay: 0s; }
.card:nth-child(2) { animation-delay: 0.06s; }
.card:nth-child(3) { animation-delay: 0.12s; }
.card:nth-child(4) { animation-delay: 0.18s; }
.card:nth-child(5) { animation-delay: 0.24s; }
.card:nth-child(6) { animation-delay: 0.3s; }
.card:nth-child(7) { animation-delay: 0.36s; }
.card:nth-child(8) { animation-delay: 0.42s; }

/* ============ 暗色模式适配 ============ */
@media (prefers-color-scheme: dark) {
  .result-hero-label {
    color: #94a3b8;
  }

  .result-hero-slogan {
    background: rgba(255, 255, 255, 0.08);
    color: #94a3b8;
  }

  .section-title {
    color: #a78bfa;
  }

  .section-title::before {
    background: linear-gradient(180deg, #a78bfa, #7c3aed);
  }

  .trait-item.trait-strength {
    background: rgba(74, 222, 128, 0.08);
    color: #86efac;
  }

  .trait-item.trait-weakness {
    background: rgba(248, 113, 113, 0.08);
    color: #fca5a5;
  }

  .career-tag {
    background: rgba(139, 92, 246, 0.12);
    color: #c4b5fd;
  }

  .famous-tag {
    background: rgba(251, 191, 36, 0.1);
    color: #fcd34d;
  }

  .match-block {
    border: 1rpx solid rgba(139, 92, 246, 0.08);
  }

  button.btn {
    background: rgba(139, 92, 246, 0.1);
    color: #c4b5fd;
  }

  button.secondary-btn {
    border-color: rgba(139, 92, 246, 0.2);
  }
}

/* 置信度提示 */
.confidence-tip {
  background: rgba(251, 191, 36, 0.08);
  border: 1rpx solid rgba(251, 191, 36, 0.3);
}

.confidence-tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #92400e;
  margin-bottom: 12rpx;
}

.confidence-tip-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: #78350f;
}
