.result-type {
  font-size: 92rpx;
  font-weight: 800;
  line-height: 1;
  margin: 10rpx 0 16rpx;
  letter-spacing: -3rpx;
  font-feature-settings: "palt";
}

.section-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #4f46e5;
  margin: 10rpx 0 30rpx;
  position: relative;
}

.section-title::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 0;
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(to right, #7c3aed, #a855f7);
  border-radius: 3rpx;
}

/* 更优雅的正文排版 */
.card {
  font-size: 30rpx;
  line-height: 1.75;
  color: #334155;
}

.section-title {
  font-size: 36rpx;
  letter-spacing: -0.5rpx;
}

/* 重置 button 默认样式，使其与 view.btn 完全一致 */
button.btn {
  margin: 0;
  padding: 0;
  border: none;
  line-height: 100rpx;
  font-size: 36rpx;
  font-weight: 600;
  border-radius: 50rpx;
  box-sizing: border-box;
}

button.btn::after {
  border: none;
}

button.secondary-btn {
  border: 4rpx solid #7c3aed;
}

/* 截图画布（不可见） */
.share-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 750rpx;
  height: 880rpx;
}