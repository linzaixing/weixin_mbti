.container {
  padding: 30rpx;
  background: #f8fafc;
  min-height: 100vh;
}

.card {
  background: white;
  border-radius: 32rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(124, 58, 237, 0.12);
}

.btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.primary-btn {
  background: linear-gradient(135deg, #7c3aed, #a855f7);
  color: white;
  margin-top: 20rpx;
}

.secondary-btn {
  background: white;
  color: #64748b;
  border: 4rpx solid #e2e8f0;
}