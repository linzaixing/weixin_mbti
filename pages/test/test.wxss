.container {
  padding: 32rpx;
  padding-bottom: 300rpx;
}

.question {
  font-size: 36rpx;
  line-height: 1.8;
  font-weight: 600;
  color: #1e1b4b;
  letter-spacing: 0.5rpx;
}

.option {
  font-size: 30rpx;
  line-height: 1.7;
  padding: 34rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.5);
}

/* 进度区域 */
.test-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.test-counter {
  font-size: 30rpx;
  color: #64748b;
}

.test-counter-num {
  color: #6d28d9;
  font-weight: 700;
}

.test-mode-tag {
  font-size: 22rpx;
  color: #6d28d9;
  background: rgba(124, 58, 237, 0.08);
  padding: 6rpx 20rpx;
  border-radius: 9999px;
  letter-spacing: 1rpx;
}

/* 底部导航栏 */
.test-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(124, 58, 237, 0.06);
}

/* 底部提示 */
.test-hint {
  width: 100%;
  text-align: center;
  font-size: 22rpx;
  color: #a1a1aa;
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
}

/* 题目切换动画 */
@keyframes questionIn {
  from {
    opacity: 0;
    transform: translateX(30rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.question-card {
  animation: questionIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
}

/* ============ 暗色模式适配 ============ */
@media (prefers-color-scheme: dark) {
  .test-counter {
    color: #94a3b8;
  }

  .test-mode-tag {
    color: #a78bfa;
    background: rgba(139, 92, 246, 0.12);
  }

  .test-nav {
    background: rgba(15, 10, 30, 0.85);
    border-top-color: rgba(139, 92, 246, 0.1);
  }

  .test-hint {
    color: #71717a;
  }

  .option {
    background: rgba(30, 20, 50, 0.4);
  }
}
