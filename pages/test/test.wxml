<view class="container">
  <!-- 进度 -->
  <view class="card">
    <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx;">
      <view style="font-size: 32rpx; color: #64748b;">第 <text style="color: #7c3aed; font-weight: bold;">{{current + 1}}</text> / {{questions.length}} 题</view>
      <view style="font-size: 28rpx; color: #94a3b8;">MBTI测试</view>
    </view>
    <view class="progress">
      <view class="progress-bar" style="width: {{progress}}%"></view>
    </view>
  </view>

  <!-- 问题卡片 -->
  <view class="card">
    <view class="question">{{questions[current].text}}</view>
    
    <view wx:for="{{questions[current].options}}" wx:key="id" 
          class="option {{selectedOption === item.id ? 'selected' : ''}}" 
          bindtap="selectOption" 
          data-id="{{item.id}}">
      {{item.text}}
    </view>
  </view>

  <!-- 底部导航 -->
  <view style="position: fixed; bottom: 40rpx; left: 0; right: 0; padding: 0 40rpx; display: flex; gap: 20rpx;">
    <view class="btn secondary-btn" 
          style="flex: 1; opacity: {{current === 0 ? 0.5 : 1}}"
          bindtap="prevQuestion"
          wx:if="{{current > 0}}">
      上一题
    </view>
    <view class="btn primary-btn" 
          style="flex: 1;"
          bindtap="nextQuestion">
      {{current === questions.length - 1 ? '完成测试' : '下一题'}}
    </view>
  </view>

  <!-- 提示 -->
  <view style="position: fixed; bottom: 220rpx; left: 50%; transform: translateX(-50%); font-size: 24rpx; color: #94a3b8; text-align: center;">
    请选择最符合你日常感受的选项
  </view>
</view>