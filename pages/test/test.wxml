<view class="container">
  <!-- 进度 -->
  <view class="card">
    <view class="test-header">
      <view class="test-counter">第 <text class="test-counter-num">{{current + 1}}</text> / {{questions.length}} 题</view>
      <view class="test-mode-tag">{{testMode === 'sbti' ? 'SBTI测试' : testMode === 'nmti' ? 'NMTI测试' : 'MBTI测试'}}</view>
    </view>
    <view class="progress">
      <view class="progress-bar" style="width: {{progress}}%"></view>
    </view>
  </view>

  <!-- 问题卡片 -->
  <view class="card question-card">
    <view class="question">{{questions[current].text}}</view>
    
    <view wx:for="{{questions[current].options}}" wx:key="id" 
          class="option {{selectedOption === item.id ? 'selected' : ''}}" 
          bindtap="selectOption" 
          data-id="{{item.id}}">
      {{item.text}}
    </view>
  </view>

  <!-- 底部导航 -->
  <view class="test-nav">
    <view class="test-hint">请选择最符合你日常感受的选项</view>
    <view style="display: flex; gap: 20rpx; width: 100%;">
      <view class="btn secondary-btn" 
            hover-class="secondary-btn-active"
            style="flex: 1;"
            bindtap="prevQuestion"
            wx:if="{{current > 0}}">
        上一题
      </view>
      <view class="btn primary-btn" 
            hover-class="primary-btn-active"
            style="flex: 1;"
            bindtap="nextQuestion">
        {{current === questions.length - 1 ? '完成测试' : '下一题'}}
      </view>
    </view>
  </view>
</view>
