.tab-bar {
  display: flex;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #ffffff;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 -2rpx 24rpx rgba(0, 0, 0, 0.04);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0 6rpx;
  transition: all 0.2s ease;
}

.tab-icon {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 6rpx;
}

.tab-label {
  font-size: 26rpx;
  color: #94a3b8;
  font-weight: 500;
  letter-spacing: 4rpx;
  font-family: "PingFang SC", "SF Pro Display", "Helvetica Neue", system-ui, sans-serif;
}

.tab-item.active .tab-label {
  color: #6d28d9;
  font-weight: 700;
}

.tab-item.active .tab-icon {
  transform: scale(1.05);
}
