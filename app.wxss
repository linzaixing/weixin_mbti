/**app.wxss**/
page {
  background: linear-gradient(180deg, #f3eeff 0%, #fdf2f8 25%, #f8fafc 60%, #f1f5f9 100%);
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

.container {
  padding: 28rpx 32rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #1e1b4b;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #64748b;
  margin-bottom: 40rpx;
  letter-spacing: 0.5rpx;
}

.btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 600;
  margin: 16rpx 0;
  text-align: center;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  letter-spacing: 1rpx;
}

.primary-btn {
  background: linear-gradient(135deg, #6d28d9, #7c3aed 50%, #8b5cf6);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(109, 40, 217, 0.35);
}

.primary-btn-active {
  background: linear-gradient(135deg, #5b21b6, #6d28d9 50%, #7c3aed);
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(109, 40, 217, 0.4);
}

.secondary-btn {
  background: rgba(124, 58, 237, 0.06);
  color: #6d28d9;
  border: 2rpx solid rgba(124, 58, 237, 0.2);
  box-shadow: none;
}

.secondary-btn-active {
  background: rgba(124, 58, 237, 0.12);
  border-color: rgba(124, 58, 237, 0.4);
  color: #5b21b6;
  transform: scale(0.96);
}

.sbti-btn {
  background: rgba(124, 58, 237, 0.08);
  color: #6d28d9;
  border: 2rpx solid rgba(124, 58, 237, 0.18);
  box-shadow: none;
}

.sbti-btn-active {
  background: rgba(124, 58, 237, 0.15);
  border-color: rgba(124, 58, 237, 0.35);
  transform: scale(0.96);
}

.nmti-btn {
  background: rgba(124, 58, 237, 0.08);
  color: #6d28d9;
  border: 2rpx solid rgba(124, 58, 237, 0.18);
  box-shadow: none;
}

.nmti-btn-active {
  background: rgba(124, 58, 237, 0.15);
  border-color: rgba(124, 58, 237, 0.35);
  transform: scale(0.96);
}

.card {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 32rpx;
  padding: 44rpx;
  margin: 24rpx 0;
  box-shadow:
    0 2rpx 8rpx rgba(124, 58, 237, 0.04),
    0 12rpx 40rpx rgba(124, 58, 237, 0.08);
  position: relative;
  overflow: hidden;
}

.progress {
  height: 10rpx;
  background: rgba(124, 58, 237, 0.08);
  border-radius: 9999px;
  overflow: hidden;
  margin: 30rpx 0;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #7c3aed, #a78bfa);
  border-radius: 9999px;
  transition: width 0.3s ease;
}

.question {
  font-size: 36rpx;
  line-height: 1.7;
  color: #1e1b4b;
  margin-bottom: 60rpx;
  font-weight: 500;
}

.option {
  padding: 32rpx;
  margin: 20rpx 0;
  border: 2rpx solid rgba(124, 58, 237, 0.12);
  border-radius: 24rpx;
  font-size: 32rpx;
  color: #334155;
  background: rgba(255, 255, 255, 0.6);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.option:active {
  transform: scale(0.98);
  background: rgba(243, 232, 255, 0.5);
}

.option.selected {
  border-color: rgba(124, 58, 237, 0.5);
  background: rgba(243, 232, 255, 0.6);
  color: #5b21b6;
  box-shadow: 0 4rpx 16rpx rgba(124, 58, 237, 0.12);
}

.result-type {
  font-size: 72rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #6d28d9, #a855f7 50%, #ec4899);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-align: center;
  margin: 20rpx 0;
  letter-spacing: 2rpx;
}

.report-section {
  margin-top: 44rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #6d28d9;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid rgba(124, 58, 237, 0.12);
}

/* ============ 暗色模式适配 ============ */
@media (prefers-color-scheme: dark) {
  page {
    background: linear-gradient(180deg, #1a0533 0%, #1e1028 25%, #0f172a 60%, #0c0a1a 100%);
  }

  .title {
    color: #e9e5f5;
  }

  .subtitle {
    color: #94a3b8;
  }

  .card {
    background: rgba(30, 20, 50, 0.7);
    border: 1rpx solid rgba(139, 92, 246, 0.15);
    box-shadow:
      0 2rpx 8rpx rgba(0, 0, 0, 0.3),
      0 12rpx 40rpx rgba(0, 0, 0, 0.2);
  }

  .secondary-btn {
    background: rgba(139, 92, 246, 0.1);
    color: #c4b5fd;
    border-color: rgba(139, 92, 246, 0.25);
  }

  .secondary-btn-active {
    background: rgba(139, 92, 246, 0.2);
    border-color: rgba(139, 92, 246, 0.4);
    color: #ddd6fe;
  }

  .sbti-btn,
  .nmti-btn {
    background: rgba(139, 92, 246, 0.1);
    color: #c4b5fd;
    border-color: rgba(139, 92, 246, 0.2);
  }

  .sbti-btn-active,
  .nmti-btn-active {
    background: rgba(139, 92, 246, 0.2);
    border-color: rgba(139, 92, 246, 0.35);
  }

  .option {
    background: rgba(30, 20, 50, 0.5);
    border-color: rgba(139, 92, 246, 0.15);
    color: #cbd5e1;
  }

  .option:active {
    background: rgba(109, 40, 217, 0.15);
  }

  .option.selected {
    background: rgba(109, 40, 217, 0.2);
    border-color: rgba(139, 92, 246, 0.5);
    color: #ddd6fe;
  }

  .question {
    color: #e2e8f0;
  }

  .progress {
    background: rgba(139, 92, 246, 0.12);
  }

  .section-title {
    color: #a78bfa;
    border-bottom-color: rgba(139, 92, 246, 0.15);
  }

  .result-type {
    background: linear-gradient(135deg, #a78bfa, #c084fc 50%, #f472b6);
    -webkit-background-clip: text;
  }
}